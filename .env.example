# Segurança do servidor — nunca coloque valores reais no GitHub.
SESSION_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# Credenciais temporárias de autenticação do servidor.
ADMIN_USER_ID=ekimane
ADMIN_PASSWORD=defina-no-Vercel-ou-no-.env.local
RH_USER_ID=ifloma
RH_PASSWORD=defina-no-Vercel-ou-no-.env.local
OUTRO_USER_ID=ifloma
OUTRO_PASSWORD=defina-no-Vercel-ou-no-.env.local

# Banco atual: SQLite local. O valor real do caminho pode ser alterado no ambiente.
DATABASE_MODE=local
LOCAL_DATABASE_PATH=./data/controle-ferias.sqlite

# Banco central PostgreSQL — usado quando DATABASE_MODE=postgres.
DATABASE_URL=postgresql://utilizador:senha@servidor:5432/base
DATABASE_SSL=true

# Sincronização bidirecional do aplicativo Windows com o servidor central.
# No PC local, CENTRAL_API_URL aponta para a aplicação central publicada.
# SYNC_TOKEN deve ser um segredo longo e aleatório partilhado entre os dois lados.
CENTRAL_API_URL=https://seu-servidor-central.exemplo.com
SYNC_TOKEN=gere-um-token-aleatorio-e-secreto
SYNC_DEVICE_ID=opcional-identificador-fixo-do-computador
